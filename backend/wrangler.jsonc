{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hassan-ai-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hassan-ai",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "hassan-ai-evidence"
    }
  ],
  "workflows": [
    {
      "binding": "TASK_WORKFLOW",
      "name": "hassan-task-workflow",
      "class_name": "TaskWorkflow"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
